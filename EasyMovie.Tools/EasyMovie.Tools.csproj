<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EasyMovie.Core\EasyMovie.Core.csproj" />
    <ProjectReference Include="..\EasyMovie.Data\EasyMovie.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- M1（2026-09-20）：已永久移除 <NoWarn>，恢复可空引用静态保护。
         原先抑制 CS4014/CS8625/CS8602/CS8604/CS8629/CS8601——实测该项下唯一的告警面是
         14 条可空告警（10×CS8602 系 DoubanBackfillService 一处多余 `rep != null` 判空的级联，
         3×CS8604、1×CS8601），已全部按真实根因修复；CS4014 在本项目为零。
         保持 Nullable 分析全开可让新增代码的空引用缺陷在编译期即暴露。 -->
  </PropertyGroup>

</Project>
