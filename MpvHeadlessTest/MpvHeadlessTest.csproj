<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Platform>x64</Platform>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Endpne.LibMPV.Windows" Version="0.41.0" />
  </ItemGroup>

  <!-- 从 NuGet 缓存把 libmpv-2.dll 复制到输出根目录 -->
  <Target Name="CopyLibMpv" AfterTargets="Build">
    <Copy SourceFiles="$(NuGetPackageRoot)endpne.libmpv.windows\0.41.0\build\x64\libmpv-2.dll"
          DestinationFiles="$(OutDir)libmpv-2.dll"
          SkipUnchangedFiles="true"
          Condition="Exists('$(NuGetPackageRoot)endpne.libmpv.windows\0.41.0\build\x64\libmpv-2.dll')" />
  </Target>

</Project>
