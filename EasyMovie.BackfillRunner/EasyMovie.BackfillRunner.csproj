<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 与 EasyMovie.Tools 一致：抑制可空引用注解缺口（CS86xx）与 fire-and-forget async（CS4014）噪音警告 -->
    <NoWarn>CS4014;CS8625;CS8602;CS8604;CS8629;CS8601</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EasyMovie.Tools\EasyMovie.Tools.csproj" />
  </ItemGroup>

</Project>
