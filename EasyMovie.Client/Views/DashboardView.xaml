<UserControl x:Class="EasyMovie.Client.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:EasyMovie.Client.Converters"
             xmlns:behaviors="clr-namespace:EasyMovie.Client.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <conv:PlaybackProgressConverter x:Key="PlaybackProgressConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="8,2,8,12">

            <!-- 问候语 + 随机推荐 -->
            <Border CornerRadius="10" Padding="14,10" Margin="0,0,0,8"
                    Background="{DynamicResource MaterialDesignCardBackground}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="GreetingText" FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource MaterialDesignBody}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="GreetingEmoji" Text="☀️" FontSize="20"
                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Dashboard_GreetingSuffix}"
                                   FontSize="13" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <Button x:Name="RandomPickBtn" Grid.Column="1"
                            Content="{DynamicResource Dashboard_RandomPick}"
                            Style="{StaticResource MaterialDesignRaisedAccentButton}"
                            FontSize="14" MinWidth="150" Height="40" Padding="16,0"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center" HorizontalContentAlignment="Center"
                            Click="RandomPickBtn_Click" />
                </Grid>
            </Border>

            <!-- 统计卡片行 -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" x:Name="StatCard0" CornerRadius="10" Padding="12,10" Margin="0,0,8,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#7C4DFF" Offset="0"/>
                            <GradientStop Color="#B388FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dashboard_TotalMovies}" FontSize="10" Foreground="#FFFFFFCC" />
                        <TextBlock x:Name="TotalMoviesText" Text="0" FontSize="26" FontWeight="Bold" Foreground="White" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" x:Name="StatCard1" CornerRadius="10" Padding="12,10" Margin="8,0,8,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4CAF50" Offset="0"/>
                            <GradientStop Color="#81C784" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dashboard_MonthWatched}" FontSize="10" Foreground="#FFFFFFCC" />
                        <TextBlock x:Name="MonthWatchedText" Text="0" FontSize="26" FontWeight="Bold" Foreground="White" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" x:Name="StatCard2" CornerRadius="10" Padding="12,10" Margin="8,0,8,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF9800" Offset="0"/>
                            <GradientStop Color="#FFB74D" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dashboard_TotalHours}" FontSize="10" Foreground="#FFFFFFCC" />
                        <TextBlock x:Name="TotalHoursText" Text="0" FontSize="26" FontWeight="Bold" Foreground="White" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" x:Name="StatCard3" CornerRadius="10" Padding="12,10" Margin="8,0,8,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#E91E63" Offset="0"/>
                            <GradientStop Color="#F06292" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dashboard_AvgRating}" FontSize="10" Foreground="#FFFFFFCC" />
                        <TextBlock x:Name="AvgRatingText" Text="0" FontSize="26" FontWeight="Bold" Foreground="White" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" x:Name="StatCard4" CornerRadius="10" Padding="12,10" Margin="8,0,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#00BCD4" Offset="0"/>
                            <GradientStop Color="#4DD0E1" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dashboard_Favorites}" FontSize="10" Foreground="#FFFFFFCC" />
                        <TextBlock x:Name="FavoritesText" Text="0" FontSize="26" FontWeight="Bold" Foreground="White" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 继续观看 + 最近添加：同一行（左 继续观看 / 右 最近添加） -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左列：继续观看 -->
                <Border Grid.Column="0" x:Name="ContinueWatchingPanel" CornerRadius="10" Padding="12,10" Margin="0,0,8,0"
                        Background="{DynamicResource MaterialDesignCardBackground}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Dashboard_ContinueWatching}" FontSize="15" FontWeight="SemiBold"
                                   Margin="4,0,0,6" Foreground="{DynamicResource MaterialDesignBody}" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Height="150">
                            <ItemsControl x:Name="ContinueWatchingList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="80" Height="130" Margin="0,0,8,0" CornerRadius="6"
                                                Background="{DynamicResource MaterialDesignCardBackground}"
                                                Cursor="Hand" MouseLeftButtonDown="ContinueWatchingCard_Click">
                                            <StackPanel>
                                                <Border Width="80" Height="110" CornerRadius="6,6,0,0"
                                                        Background="{DynamicResource MaterialDesignDivider}">
                                                    <Grid>
                                                        <Image Stretch="UniformToFill"
                                                               behaviors:PosterImageBehavior.Movie="{Binding}"
                                                               behaviors:PosterImageBehavior.DecodeWidth="160"
                                                               behaviors:PosterImageBehavior.DecodeHeight="240" />
                                                        <Grid VerticalAlignment="Bottom" Height="5" Background="#40000000">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition>
                                                                    <ColumnDefinition.Width>
                                                                        <MultiBinding Converter="{StaticResource PlaybackProgressConverter}">
                                                                            <Binding Path="PlaybackPosition" />
                                                                            <Binding Path="Runtime" />
                                                                        </MultiBinding>
                                                                    </ColumnDefinition.Width>
                                                                </ColumnDefinition>
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Background="#FF4081" />
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontSize="10" Margin="4,2"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- 右列：最近添加 -->
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="{DynamicResource Dashboard_RecentlyAdded}" FontSize="15" FontWeight="SemiBold"
                               Margin="4,0,0,4" Foreground="{DynamicResource MaterialDesignBody}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Height="150">
                        <ItemsControl x:Name="RecentAddedList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="80" Height="130" Margin="0,0,8,0" CornerRadius="6"
                                            Background="{DynamicResource MaterialDesignCardBackground}"
                                            Cursor="Hand" MouseLeftButtonDown="MovieCard_Click">
                                        <StackPanel>
                                            <Border Width="80" Height="110" CornerRadius="6,6,0,0"
                                                    Background="{DynamicResource MaterialDesignDivider}">
                                                <Image Stretch="UniformToFill"
                                                       behaviors:PosterImageBehavior.Movie="{Binding}"
                                                       behaviors:PosterImageBehavior.DecodeWidth="160"
                                                       behaviors:PosterImageBehavior.DecodeHeight="240" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontSize="10" Margin="4,2"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Grid>

            <!-- 类型分布 + 最近观看：同一行（类型分布在左，最近观看在右；避免整页出现滚动条） -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左列：类型分布 -->
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="{DynamicResource Dashboard_GenreDistribution}" FontSize="15" FontWeight="SemiBold"
                               Margin="4,0,0,6" Foreground="{DynamicResource MaterialDesignBody}" />
                    <Border CornerRadius="8" Padding="12,10"
                            Background="{DynamicResource MaterialDesignCardBackground}">
                        <StackPanel x:Name="GenreChartPanel" />
                    </Border>
                </StackPanel>

                <!-- 右列：最近观看 -->
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="{DynamicResource Dashboard_RecentlyWatched}" FontSize="15" FontWeight="SemiBold"
                               Margin="4,0,0,4" Foreground="{DynamicResource MaterialDesignBody}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Height="150">
                        <ItemsControl x:Name="RecentWatchedList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="80" Height="130" Margin="0,0,8,0" CornerRadius="6"
                                            Background="{DynamicResource MaterialDesignCardBackground}"
                                            Cursor="Hand" MouseLeftButtonDown="MovieCard_Click">
                                        <StackPanel>
                                            <Border Width="80" Height="110" CornerRadius="6,6,0,0"
                                                    Background="{DynamicResource MaterialDesignDivider}">
                                                <Image Stretch="UniformToFill"
                                                       behaviors:PosterImageBehavior.Movie="{Binding}"
                                                       behaviors:PosterImageBehavior.DecodeWidth="160"
                                                       behaviors:PosterImageBehavior.DecodeHeight="240" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontSize="10" Margin="4,2"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Grid>

            <!-- 即将上映·你的想看（全宽，默认折叠；有数据时才出现，不增加常态页面高度/滚动条） -->
            <Border x:Name="UpcomingReminderPanel" CornerRadius="10" Padding="12,10" Margin="0,0,0,8"
                    Background="{DynamicResource MaterialDesignCardBackground}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Dashboard_UpcomingReminder}" FontSize="15" FontWeight="SemiBold"
                               Margin="4,0,0,6" Foreground="{DynamicResource MaterialDesignBody}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Height="150">
                        <ItemsControl x:Name="UpcomingReminderList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="80" Height="130" Margin="0,0,8,0" CornerRadius="6"
                                            Background="{DynamicResource MaterialDesignCardBackground}"
                                            Cursor="Hand" MouseLeftButtonDown="UpcomingReminderCard_Click">
                                        <StackPanel>
                                            <Border Width="80" Height="110" CornerRadius="6,6,0,0"
                                                    Background="{DynamicResource MaterialDesignDivider}">
                                                <Grid>
                                                    <Image Stretch="UniformToFill"
                                                           behaviors:PosterImageBehavior.Movie="{Binding Movie}"
                                                           behaviors:PosterImageBehavior.DecodeWidth="160"
                                                           behaviors:PosterImageBehavior.DecodeHeight="240" />
                                                    <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                                                            Margin="4" Padding="4,1" CornerRadius="3"
                                                            Background="#40000000" Visibility="{Binding Rating, Converter={StaticResource NullToCollapsedConverter}}">
                                                        <TextBlock Text="{Binding Rating, StringFormat={}{0:0.0}}" FontSize="10"
                                                                   Foreground="White" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Movie.Title}" FontSize="10" Margin="4,2"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>