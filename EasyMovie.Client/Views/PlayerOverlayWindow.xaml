<Window x:Class="EasyMovie.Client.Views.PlayerOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="LowQuality"
        Title="PlayerOverlay" Width="400" Height="300">

    <Window.Resources>
        <!-- 播放器悬浮按钮的 ToolTip：深色底 + 白字，避免默认浅灰底看不清。
             注意：不用 HasDropShadow（AllowsTransparency 分层窗口里阴影走软件渲染，会导致卡顿）。 -->
        <Style x:Key="PlayerToolTipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="#F01E1E2E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#44FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <!-- 显式模板：强制内容文字为白色，避免被主题 ToolTip 模板覆盖前景色（之前在深色底上文字看不清） -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter TextElement.FontSize="12"
                                              TextElement.Foreground="White" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 背景用 alpha=1(#01000000)而非 Transparent(alpha=0)：
         在 AllowsTransparency 分层窗口里，DWM 会把 alpha=0 的像素视为不存在，
         点击会“穿透”到下层视频 HWND，导致画面区域点击收不到（按钮能点、画面点击失效）。
         alpha=1 几乎不可见，但能让该区域正常命中测试，单击暂停/双击全屏即可生效。 -->
    <Grid x:Name="Root" Background="#01000000" Cursor="Arrow"
          TextOptions.TextRenderingMode="Grayscale"
          MouseLeftButtonDown="Root_MouseLeftButtonDown"
          MouseLeftButtonUp="Root_MouseLeftButtonUp"
          MouseMove="Root_MouseMove"
          MouseWheel="Root_MouseWheel">
        <!-- 顶部标题/返回栏 -->
        <Border x:Name="TitleBar" VerticalAlignment="Top" Background="#CC000000" Padding="12,8"
                Visibility="Collapsed" Cursor="Arrow">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource MaterialDesignIconForegroundButton}" Foreground="White"
                            Width="36" Height="36" Click="Back_Click" Cursor="Hand">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="22" Height="22" />
                    </Button>
                    <TextBlock x:Name="WindowTitleLabel" Text="" FontSize="14" Foreground="White"
                               VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Style="{StaticResource MaterialDesignIconForegroundButton}" Foreground="White"
                        Width="36" Height="36" HorizontalAlignment="Right" Click="Fullscreen_Click" Cursor="Hand">
                    <materialDesign:PackIcon x:Name="FullscreenIcon" Kind="Fullscreen" Width="20" Height="20" />
                    <Button.ToolTip>
                        <ToolTip Style="{StaticResource PlayerToolTipStyle}"><TextBlock Text="全屏 (F)" Foreground="White" /></ToolTip>
                    </Button.ToolTip>
                </Button>
            </Grid>
        </Border>

        <!-- 画面比例切换提示（悬浮顶部居中，短暂显示） -->
        <Border x:Name="AspectTooltip" Visibility="Collapsed"
                VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,56,0,0"
                Background="#CC000000" CornerRadius="6" Padding="12,6">
            <TextBlock x:Name="AspectTooltipText" Text="" FontSize="13" Foreground="White" />
        </Border>

        <!-- 续播提示（悬浮居中） -->
        <Border x:Name="ResumePanel" Visibility="Collapsed"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="#CC1E1E2E" CornerRadius="12" Padding="24,16"
                Cursor="Hand">
            <StackPanel>
                <TextBlock x:Name="ResumeText" Text="{DynamicResource Player_ResumePrompt}" FontSize="16"
                           Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock x:Name="ResumeTimeText" FontSize="13"
                           Foreground="#AAFFFFFF" HorizontalAlignment="Center" Margin="0,0,0,12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="ResumeYesBtn" Content="{DynamicResource Player_ResumeYes}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Foreground="White" Background="#7C4DFF" Margin="0,0,8,0"
                            Click="ResumeYes_Click" Cursor="Hand" />
                    <Button x:Name="ResumeNoBtn"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Click="ResumeNo_Click" Cursor="Hand">
                        <TextBlock Text="{DynamicResource Player_ResumeNo}" Foreground="White" FontSize="14" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 底部控制栏 -->
        <Border x:Name="ControlBar" VerticalAlignment="Bottom"
                Background="#CC000000" Padding="16,8"
                Visibility="Collapsed" Cursor="Arrow">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 进度条 -->
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Slider x:Name="SeekBar" Minimum="0" Maximum="100" Value="0"
                            Style="{StaticResource MaterialDesignSlider}"
                            Thumb.DragStarted="SeekBar_DragStarted"
                            Thumb.DragCompleted="SeekBar_DragCompleted"
                            ValueChanged="SeekBar_ValueChanged" />
                    <!-- 进度条缩略图预览：拖动时浮在进度条上方，显示当前位置的画面缩略图 -->
                    <Border x:Name="ThumbPreview" Visibility="Collapsed" Width="160" Height="94"
                            Background="#CC000000" BorderBrush="#55FFFFFF" BorderThickness="1"
                            CornerRadius="4" Padding="2" HorizontalAlignment="Left"
                            VerticalAlignment="Top" Margin="0,-112,0,0" IsHitTestVisible="False">
                        <StackPanel>
                            <Image x:Name="ThumbImage" Width="156" Height="70" Stretch="Uniform" />
                            <TextBlock x:Name="ThumbTime" Text="00:00" Foreground="White" FontSize="10"
                                       HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="SeekTooltip" Text="00:00"
                               Foreground="White" FontSize="11"
                               VerticalAlignment="Top" HorizontalAlignment="Left"
                               Margin="0,-16,0,0" Visibility="Collapsed" />
                </Grid>

                <!-- 控制按钮行 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 播放/暂停 -->
                    <Button Grid.Column="0" x:Name="PlayPauseBtn" Width="36" Height="36"
                            Style="{StaticResource MaterialDesignIconForegroundButton}"
                            Foreground="White" Click="PlayPause_Click" Cursor="Hand">
                        <materialDesign:PackIcon x:Name="PlayPauseIcon" Kind="Pause" Width="20" Height="20" />
                    </Button>

                    <!-- 停止 -->
                    <Button Grid.Column="1" Width="36" Height="36"
                            Style="{StaticResource MaterialDesignIconForegroundButton}"
                            Foreground="White" Click="Stop_Click" Cursor="Hand">
                        <materialDesign:PackIcon Kind="Stop" Width="18" Height="18" />
                    </Button>

                    <!-- 字幕 -->
                    <Button Grid.Column="2" x:Name="SubtitleBtn" Width="36" Height="36"
                            Style="{StaticResource MaterialDesignIconForegroundButton}"
                            Foreground="White" Click="Subtitle_Click" Cursor="Hand">
                        <materialDesign:PackIcon Kind="Subtitles" Width="18" Height="18" />
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource PlayerToolTipStyle}"><TextBlock Text="字幕 (S截图 / C倍速 / ,.，调延迟)" Foreground="White" /></ToolTip>
                        </Button.ToolTip>
                    </Button>

                    <!-- 音轨 -->
                    <Button Grid.Column="3" x:Name="AudioBtn" Width="36" Height="36"
                            Style="{StaticResource MaterialDesignIconForegroundButton}"
                            Foreground="White" Click="Audio_Click" Cursor="Hand">
                        <materialDesign:PackIcon Kind="PlaylistMusic" Width="18" Height="18" />
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource PlayerToolTipStyle}"><TextBlock Text="音轨" Foreground="White" /></ToolTip>
                        </Button.ToolTip>
                    </Button>

                    <!-- 倍速 -->
                    <Button Grid.Column="4" x:Name="RateBtn" Width="48" Height="36"
                            Style="{StaticResource MaterialDesignIconForegroundButton}"
                            Foreground="White" Click="Rate_Click" Cursor="Hand">
                        <TextBlock x:Name="RateLabel" Text="1.0x" FontSize="12" Foreground="White"
                                   VerticalAlignment="Center" />
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource PlayerToolTipStyle}"><TextBlock Text="倍速 (C)" Foreground="White" /></ToolTip>
                        </Button.ToolTip>
                    </Button>

                    <!-- 时间显示 -->
                    <TextBlock Grid.Column="5" x:Name="TimeLabel" Text="00:00 / 00:00"
                               Foreground="White" FontSize="12" VerticalAlignment="Center"
                               HorizontalAlignment="Center" Margin="8,0" />

                    <!-- 截图 -->
                    <Button Grid.Column="6" Width="36" Height="36"
                            Style="{StaticResource MaterialDesignIconForegroundButton}"
                            Foreground="White" Click="Snapshot_Click" Cursor="Hand">
                        <materialDesign:PackIcon Kind="Camera" Width="18" Height="18" />
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource PlayerToolTipStyle}"><TextBlock Text="截图 (S)" Foreground="White" /></ToolTip>
                        </Button.ToolTip>
                    </Button>

                    <!-- 画面比例切换：原始 / 铺满 / 16:9 / 4:3 循环。
                         按钮上常驻显示当前模式短标签，避免“不知道现在是哪个比例”。 -->
                    <Button Grid.Column="7" Width="72" Height="36" Padding="0"
                            Style="{StaticResource MaterialDesignIconForegroundButton}"
                            Foreground="White" Click="Aspect_Click" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="AspectRatio" Width="18" Height="18"
                                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="AspectLabel" Text="原始" FontSize="11" Foreground="White"
                                       VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource PlayerToolTipStyle}"><TextBlock Text="画面比例（点击循环：原始 / 铺满 / 16:9 / 4:3）" Foreground="White" /></ToolTip>
                        </Button.ToolTip>
                    </Button>

                    <!-- 音量：图标与滑块并排 -->
                    <StackPanel Grid.Column="8" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="8,0,0,0">
                        <materialDesign:PackIcon x:Name="VolumeIcon" Kind="VolumeHigh"
                                                  Width="16" Height="16" Foreground="White"
                                                  VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Slider x:Name="VolumeSlider" Width="80" Minimum="0" Maximum="200" Value="80"
                                Style="{StaticResource MaterialDesignSlider}"
                                VerticalAlignment="Center"
                                ValueChanged="VolumeSlider_ValueChanged" />
                    </StackPanel>

                    <!-- 更多（进阶功能：画面增强/编码信息/逐帧/AB/迷你） -->
                    <Button Grid.Column="9" Width="36" Height="36"
                            Style="{StaticResource MaterialDesignIconForegroundButton}"
                            Foreground="White" Click="More_Click" Cursor="Hand">
                        <materialDesign:PackIcon Kind="DotsHorizontal" Width="18" Height="18" />
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource PlayerToolTipStyle}"><TextBlock Text="更多功能" Foreground="White" /></ToolTip>
                        </Button.ToolTip>
                    </Button>

                    <!-- AB 循环（控制栏常驻入口：点击循环 设A→设B→清除） -->
                    <Button Grid.Column="10" Width="40" Height="36" Padding="0"
                            Style="{StaticResource MaterialDesignIconForegroundButton}"
                            Foreground="White" Click="AbCycle_Click" Cursor="Hand">
                        <TextBlock x:Name="AbBtnText" Text="AB" FontSize="12" Foreground="White"
                                   VerticalAlignment="Center" />
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource PlayerToolTipStyle}"><TextBlock Text="AB 循环（点击：设A → 设B → 清除）" Foreground="White" /></ToolTip>
                        </Button.ToolTip>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- 字幕面板（轨列表 + 延迟微调） -->
        <Border x:Name="SubtitlePanel" Visibility="Collapsed"
                VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="16,0,0,64"
                Background="#CC000000" CornerRadius="8" Padding="12,10" Cursor="Arrow">
            <StackPanel>
                <TextBlock Text="字幕" Foreground="White" FontSize="13" Margin="0,0,0,6" />
                <StackPanel x:Name="SubtitleTrackList" Orientation="Vertical" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                    <Button Width="56" Height="26" FontSize="11" Margin="0,0,6,0"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"
                            Click="SubDelayMinus_Click" Cursor="Hand">
                        <TextBlock Text="-0.5s" Foreground="White" />
                    </Button>
                    <Button Width="56" Height="26" FontSize="11" Margin="0,0,6,0"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"
                            Click="SubDelayPlus_Click" Cursor="Hand">
                        <TextBlock Text="+0.5s" Foreground="White" />
                    </Button>
                    <TextBlock x:Name="SubDelayLabel" Text="0.0s" Foreground="White" FontSize="11"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                    <TextBlock Text="音画同步" Foreground="White" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button Width="56" Height="26" FontSize="11" Margin="0,0,6,0"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"
                            Click="AudioDelayMinus_Click" Cursor="Hand">
                        <TextBlock Text="-0.5s" Foreground="White" />
                    </Button>
                    <Button Width="56" Height="26" FontSize="11" Margin="0,0,6,0"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"
                            Click="AudioDelayPlus_Click" Cursor="Hand">
                        <TextBlock Text="+0.5s" Foreground="White" />
                    </Button>
                    <TextBlock x:Name="AudioDelayLabel" Text="0.0s" Foreground="White" FontSize="11"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 音轨面板 -->
        <Border x:Name="AudioPanel" Visibility="Collapsed"
                VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="16,0,0,64"
                Background="#CC000000" CornerRadius="8" Padding="12,10" Cursor="Arrow">
            <StackPanel>
                <TextBlock Text="音轨" Foreground="White" FontSize="13" Margin="0,0,0,6" />
                <StackPanel x:Name="AudioTrackList" Orientation="Vertical" />
            </StackPanel>
        </Border>

        <!-- 倍速面板（全部档位供选择） -->
        <Border x:Name="RatePanel" Visibility="Collapsed"
                VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="16,0,0,64"
                Background="#CC000000" CornerRadius="8" Padding="10,8" Cursor="Arrow">
            <StackPanel x:Name="RateOptionList" Orientation="Vertical" />
        </Border>

        <!-- 通用提示（截图路径 / 字幕延迟等） -->
        <Border x:Name="Toast" Visibility="Collapsed"
                VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,120"
                Background="#CC000000" CornerRadius="6" Padding="12,6" Cursor="Arrow">
            <TextBlock x:Name="ToastText" Text="" FontSize="12" Foreground="White"
                       TextWrapping="Wrap" MaxWidth="520" />
        </Border>

        <!-- 更多功能面板 -->
        <Border x:Name="MorePanel" Visibility="Collapsed"
                VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,16,64"
                Background="#CC000000" CornerRadius="8" Padding="8" Cursor="Arrow">
            <StackPanel>
                <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"
                        HorizontalAlignment="Stretch" Margin="2" Click="PictureMenu_Click" Cursor="Hand">
                    <TextBlock Text="画面增强" Foreground="White" />
                </Button>
                <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"
                        HorizontalAlignment="Stretch" Margin="2" Click="InfoMenu_Click" Cursor="Hand">
                    <TextBlock Text="编码信息" Foreground="White" />
                </Button>
                <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"
                        HorizontalAlignment="Stretch" Margin="2" Click="StepMenu_Click" Cursor="Hand">
                    <TextBlock Text="逐帧播放" Foreground="White" />
                </Button>
                <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"
                        HorizontalAlignment="Stretch" Margin="2" Click="AbAMenu_Click" Cursor="Hand">
                    <TextBlock Text="设 A 点" Foreground="White" />
                </Button>
                <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"
                        HorizontalAlignment="Stretch" Margin="2" Click="AbBMenu_Click" Cursor="Hand">
                    <TextBlock Text="设 B 点" Foreground="White" />
                </Button>
                <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"
                        HorizontalAlignment="Stretch" Margin="2" Click="AbClearMenu_Click" Cursor="Hand">
                    <TextBlock Text="清除 AB" Foreground="White" />
                </Button>
                <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"
                        HorizontalAlignment="Stretch" Margin="2" Click="MiniMenu_Click" Cursor="Hand">
                    <TextBlock Text="迷你模式" Foreground="White" />
                </Button>
                <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"
                        HorizontalAlignment="Stretch" Margin="2" Click="ShortcutsMenu_Click" Cursor="Hand">
                    <TextBlock Text="快捷键" Foreground="White" />
                </Button>
                <Separator Margin="2,4" Background="#55FFFFFF" />
                <TextBlock Text="解码模式（重新播放后生效）" Foreground="#BBFFFFFF" FontSize="10"
                           Margin="4,2,4,0" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="DecodeSoftBtn" Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"
                            Width="56" Margin="2" FontSize="11" Click="DecodeSoft_Click" Cursor="Hand">
                        <TextBlock Text="软件" Foreground="White" />
                    </Button>
                    <Button x:Name="DecodeHardBtn" Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"
                            Width="56" Margin="2" FontSize="11" Click="DecodeHard_Click" Cursor="Hand">
                        <TextBlock Text="硬件" Foreground="White" />
                    </Button>
                    <Button x:Name="DecodeAutoBtn" Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"
                            Width="56" Margin="2" FontSize="11" Click="DecodeAuto_Click" Cursor="Hand">
                        <TextBlock Text="自动" Foreground="White" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 快捷键面板 -->
        <Border x:Name="ShortcutsPanel" Visibility="Collapsed"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="#CC000000" CornerRadius="8" Padding="16,12" Cursor="Arrow">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MaxHeight="360" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="自定义快捷键（点击右侧按键后按下新键）" Foreground="White"
                           FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap" MaxWidth="300" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ShortcutList" Orientation="Vertical" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 画面增强面板 -->
        <Border x:Name="PicturePanel" Visibility="Collapsed"
                VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="16,0,0,64"
                Background="#CC000000" CornerRadius="8" Padding="14,10" Cursor="Arrow">
            <StackPanel Width="240">
                <TextBlock Text="画面增强" Foreground="White" FontSize="13" Margin="0,0,0,8" />
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="亮度" Foreground="White" FontSize="11" VerticalAlignment="Center" />
                    <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="0" Maximum="2" Value="1" SmallChange="0.05" LargeChange="0.1"
                            Style="{StaticResource MaterialDesignSlider}" ValueChanged="BrightnessSlider_ValueChanged" />
                    <TextBlock x:Name="BrightnessVal" Grid.Column="2" Text="1.00" Foreground="White" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="对比" Foreground="White" FontSize="11" VerticalAlignment="Center" />
                    <Slider x:Name="ContrastSlider" Grid.Column="1" Minimum="0" Maximum="2" Value="1" SmallChange="0.05" LargeChange="0.1"
                            Style="{StaticResource MaterialDesignSlider}" ValueChanged="ContrastSlider_ValueChanged" />
                    <TextBlock x:Name="ContrastVal" Grid.Column="2" Text="1.00" Foreground="White" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="饱和" Foreground="White" FontSize="11" VerticalAlignment="Center" />
                    <Slider x:Name="SaturationSlider" Grid.Column="1" Minimum="0" Maximum="3" Value="1" SmallChange="0.05" LargeChange="0.1"
                            Style="{StaticResource MaterialDesignSlider}" ValueChanged="SaturationSlider_ValueChanged" />
                    <TextBlock x:Name="SaturationVal" Grid.Column="2" Text="1.00" Foreground="White" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="色相" Foreground="White" FontSize="11" VerticalAlignment="Center" />
                    <Slider x:Name="HueSlider" Grid.Column="1" Minimum="0" Maximum="360" Value="0" SmallChange="1" LargeChange="10"
                            Style="{StaticResource MaterialDesignSlider}" ValueChanged="HueSlider_ValueChanged" />
                    <TextBlock x:Name="HueVal" Grid.Column="2" Text="0" Foreground="White" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="伽马" Foreground="White" FontSize="11" VerticalAlignment="Center" />
                    <Slider x:Name="GammaSlider" Grid.Column="1" Minimum="0" Maximum="2" Value="1" SmallChange="0.05" LargeChange="0.1"
                            Style="{StaticResource MaterialDesignSlider}" ValueChanged="GammaSlider_ValueChanged" />
                    <TextBlock x:Name="GammaVal" Grid.Column="2" Text="1.00" Foreground="White" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
        <Button Width="64" Height="26" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Left"
                Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"
                Click="PictureReset_Click" Cursor="Hand">
            <TextBlock Text="重置" Foreground="White" />
        </Button>
            </StackPanel>
        </Border>

        <!-- 编码信息面板 -->
        <Border x:Name="InfoPanel" Visibility="Collapsed"
                VerticalAlignment="Center" HorizontalAlignment="Center"
