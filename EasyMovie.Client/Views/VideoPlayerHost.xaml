<UserControl x:Class="EasyMovie.Client.Views.VideoPlayerHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:wpf="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             Background="Black"
             SnapsToDevicePixels="True"
             RenderOptions.BitmapScalingMode="HighQuality"
             Loaded="Host_Loaded"
             Unloaded="Host_Unloaded"
             KeyDown="Host_KeyDown"
             Focusable="True">

    <Grid>
        <!-- 视频画面：官方 VideoView（HWND/D3D 渲染）。
             覆盖控件(返回栏/续播面板/控制栏)放在一个独立的透明覆盖窗口 PlayerOverlayWindow 中，
             该窗口是顶级窗口，永远位于视频 HWND 之上，能正常接收鼠标点击，
             彻底规避“空气墙”问题（视频子窗口会盖住 VideoView 内的 WPF 控件并吞掉点击）。 -->
        <wpf:VideoView x:Name="VideoView" Background="Black" />
    </Grid>
</UserControl>
