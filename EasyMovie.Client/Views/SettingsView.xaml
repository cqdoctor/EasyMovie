<UserControl x:Class="EasyMovie.Client.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="700">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="{DynamicResource Settings_Title}" FontSize="24" FontWeight="Bold" Margin="0,0,0,12" />

                <!-- 外观 -->
                <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="外观" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                        <WrapPanel Grid.Row="1">
                            <Button x:Name="SkinDarkBtn" Style="{StaticResource MaterialDesignRaisedButton}" Click="Skin_Click" Tag="Dark" Width="100" Height="70" Margin="0,0,12,12">
                                <Button.ContentTemplate><DataTemplate><StackPanel><Border Width="28" Height="28" CornerRadius="14" Background="#7C4DFF" HorizontalAlignment="Center"/><TextBlock Text="暗夜紫" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel></DataTemplate></Button.ContentTemplate>
                            </Button>
                            <Button x:Name="SkinOceanBtn" Style="{StaticResource MaterialDesignRaisedButton}" Click="Skin_Click" Tag="Ocean" Width="100" Height="70" Margin="0,0,12,12">
                                <Button.ContentTemplate><DataTemplate><StackPanel><Border Width="28" Height="28" CornerRadius="14" Background="#4FC3F7" HorizontalAlignment="Center"/><TextBlock Text="蓝海" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel></DataTemplate></Button.ContentTemplate>
                            </Button>
                            <Button x:Name="SkinForestBtn" Style="{StaticResource MaterialDesignRaisedButton}" Click="Skin_Click" Tag="Forest" Width="100" Height="70" Margin="0,0,12,12">
                                <Button.ContentTemplate><DataTemplate><StackPanel><Border Width="28" Height="28" CornerRadius="14" Background="#81C784" HorizontalAlignment="Center"/><TextBlock Text="森林" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel></DataTemplate></Button.ContentTemplate>
                            </Button>
                            <Button x:Name="SkinSunsetBtn" Style="{StaticResource MaterialDesignRaisedButton}" Click="Skin_Click" Tag="Sunset" Width="100" Height="70" Margin="0,0,12,12">
                                <Button.ContentTemplate><DataTemplate><StackPanel><Border Width="28" Height="28" CornerRadius="14" Background="#FFB74D" HorizontalAlignment="Center"/><TextBlock Text="日落" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel></DataTemplate></Button.ContentTemplate>
                            </Button>
                            <Button x:Name="SkinLightBtn" Style="{StaticResource MaterialDesignRaisedButton}" Click="Skin_Click" Tag="Light" Width="100" Height="70" Margin="0,0,0,6">
                                <Button.ContentTemplate><DataTemplate><StackPanel><Border Width="28" Height="28" CornerRadius="14" Background="#7C4DFF" HorizontalAlignment="Center"/><TextBlock Text="亮白" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel></DataTemplate></Button.ContentTemplate>
                            </Button>
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- 语言设置 -->
                <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{DynamicResource Settings_Language}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <Button x:Name="ZhLangBtn" Style="{StaticResource MaterialDesignRaisedButton}" Click="ZhLang_Click" Width="100" Height="70" Margin="0,0,12,0">
                                <Button.ContentTemplate><DataTemplate><StackPanel><TextBlock Text="中文" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="简体中文" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource MaterialDesignHintForeground}"/></StackPanel></DataTemplate></Button.ContentTemplate>
                            </Button>
                            <Button x:Name="EnLangBtn" Style="{StaticResource MaterialDesignRaisedButton}" Click="EnLang_Click" Width="100" Height="70">
                                <Button.ContentTemplate><DataTemplate><StackPanel><TextBlock Text="En" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="English" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource MaterialDesignHintForeground}"/></StackPanel></DataTemplate></Button.ContentTemplate>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- TMDB Key -->
                <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{DynamicResource Settings_Network}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                        <StackPanel Grid.Row="1">
                            <!-- TMDB Key -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBox x:Name="TmdbKeyBox" materialDesign:HintAssist.Hint="TMDB API Key（可选，免费申请）" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Width="340" Margin="0,0,6,0"/>
                                <Button x:Name="TmdbHelpBtn" Content="?" Style="{StaticResource MaterialDesignFlatButton}" FontWeight="Bold" Width="28" Height="28" Click="TmdbHelp_Click" ToolTip="如何获取 TMDB API Key" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border x:Name="TmdbHelpPanel" Background="{DynamicResource MaterialDesignBackground}" CornerRadius="4" Padding="10" Margin="0,0,0,6" Visibility="Collapsed">
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MaterialDesignBody}">
                                    <Run Text="如何获取 TMDB API Key：" FontWeight="Bold"/><LineBreak/>
                                    <Run Text="1. 打开 https://www.themoviedb.org/settings/api"/><LineBreak/>
                                    <Run Text="2. 注册/登录 TMDB 账号"/><LineBreak/>
                                    <Run Text="3. 点击「创建」申请 API Key"/><LineBreak/>
                                    <Run Text="4. 选择「Developer」类型，填写用途说明"/><LineBreak/>
                                    <Run Text="5. 复制生成的 API Key (v3 auth)"/><LineBreak/>
                                    <LineBreak/>
                                    <Run Text="温馨提示：TMDB API Key 免费申请，无需付费" Foreground="{DynamicResource MaterialDesignHintForeground}"/>
                                </TextBlock>
                            </Border>

                            <!-- HTTP 代理 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBox x:Name="ProxyBox" materialDesign:HintAssist.Hint="{DynamicResource Settings_ProxyHint}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Width="340" Margin="0,0,6,0"/>
                                <Border Width="28" Height="28" Background="Transparent"/>
                            </StackPanel>

                            <!-- 豆瓣 Cookie -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBox x:Name="DoubanCookieBox" materialDesign:HintAssist.Hint="{DynamicResource Settings_CookieHint}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Width="340" Margin="0,0,6,0" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
                                <Button x:Name="DoubanHelpBtn" Content="?" Style="{StaticResource MaterialDesignFlatButton}" FontWeight="Bold" Width="28" Height="28" Click="DoubanHelp_Click" ToolTip="如何获取豆瓣 Cookie" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border x:Name="DoubanHelpPanel" Background="{DynamicResource MaterialDesignBackground}" CornerRadius="4" Padding="10" Margin="0,0,0,6" Visibility="Collapsed">
                                <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Visible">
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MaterialDesignBody}">
                                        <Run Text="如何获取豆瓣 Cookie：" FontWeight="Bold"/><LineBreak/>
                                        <LineBreak/>
                                        <Run Text="方法一（推荐）：" FontWeight="Bold"/><LineBreak/>
                                        <Run Text="1. 用浏览器打开 https://movie.douban.com 并登录"/><LineBreak/>
                                        <Run Text="2. 按 F12 打开开发者工具"/><LineBreak/>
                                        <Run Text="3. 切换到「应用程序」(Application) 标签"/><LineBreak/>
                                        <Run Text="4. 左侧选择「Cookies」→「movie.douban.com」"/><LineBreak/>
                                        <Run Text="5. 找到名为「dbcl2」的 Cookie，复制完整的值"/><LineBreak/>
                                        <LineBreak/>
                                        <Run Text="方法二：从请求头复制" FontWeight="Bold"/><LineBreak/>
                                        <Run Text="1. 按 F12 → Network（网络）标签"/><LineBreak/>
                                        <Run Text="2. 在豆瓣搜索任意电影"/><LineBreak/>
                                        <Run Text="3. 点击任意请求，在 Request Headers 中找到 Cookie 字段"/><LineBreak/>
                                        <Run Text="4. 复制整段 Cookie 值粘贴到此处"/><LineBreak/>
                                        <LineBreak/>
                                        <Run Text="温馨提示：Cookie 包含登录信息，请勿分享给他人。如果多个值，请复制完整的 Cookie 字符串。" Foreground="{DynamicResource MaterialDesignHintForeground}"/>
                                    </TextBlock>
                                </ScrollViewer>
                            </Border>

                            <!-- OMDb API Key -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBox x:Name="OmdbKeyBox" materialDesign:HintAssist.Hint="OMDb API Key（可选，免费申请）" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Width="340" Margin="0,0,6,0"/>
                                <Button x:Name="OmdbHelpBtn" Content="?" Style="{StaticResource MaterialDesignFlatButton}" FontWeight="Bold" Width="28" Height="28" Click="OmdbHelp_Click" ToolTip="如何获取 OMDb API Key" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border x:Name="OmdbHelpPanel" Background="{DynamicResource MaterialDesignBackground}" CornerRadius="4" Padding="10" Margin="0,0,0,6" Visibility="Collapsed">
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MaterialDesignBody}">
                                    <Run Text="如何获取 OMDb API Key：" FontWeight="Bold"/><LineBreak/>
                                    <Run Text="1. 打开 https://www.omdbapi.com/apikey.aspx"/><LineBreak/>
                                    <Run Text="2. 选择 Free 类型（每天 1000 次请求）"/><LineBreak/>
                                    <Run Text="3. 填写邮箱，提交申请"/><LineBreak/>
                                    <Run Text="4. 到邮箱查收 API Key"/><LineBreak/>
                                    <LineBreak/>
                                    <Run Text="温馨提示：OMDb 无需代理即可访问，作为豆瓣/TMDB 之外的兜底数据源" Foreground="{DynamicResource MaterialDesignHintForeground}"/>
                                </TextBlock>
                            </Border>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="{DynamicResource Settings_Save}" Style="{StaticResource MaterialDesignFlatButton}" Click="SaveNetwork_Click" Margin="0,0,8,0"/>
                                <TextBlock x:Name="NetworkStatusText" FontSize="12" Foreground="{DynamicResource MaterialDesignHintForeground}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- AI 设置 -->
                <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{DynamicResource Settings_AI}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="{DynamicResource Settings_AIHint}" FontSize="13" Foreground="{DynamicResource MaterialDesignHintForeground}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                            <!-- 提供商选择 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="{DynamicResource Settings_AIProvider}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" Width="80"/>
                                <ComboBox x:Name="AiProviderCombo" Style="{StaticResource MaterialDesignComboBox}" Width="160"
                                          SelectionChanged="AiProvider_Changed">
                                    <ComboBoxItem Content="OpenAI" Tag="openai" />
                                    <ComboBoxItem Content="DeepSeek" Tag="deepseek" />
                                    <ComboBoxItem Content="智谱GLM" Tag="zhipu" />
                                    <ComboBoxItem Content="通义千问" Tag="qwen" />
                                    <ComboBoxItem Content="百度文心" Tag="baidu" />
                                    <ComboBoxItem Content="Moonshot" Tag="moonshot" />
                                    <ComboBoxItem Content="豆包 (字节)" Tag="doubao" />
                                    <ComboBoxItem Content="Ollama (本地)" Tag="ollama" />
                                    <ComboBoxItem Content="{DynamicResource Settings_AIProviderCustom}" Tag="custom" />
                                </ComboBox>
                            </StackPanel>
                            <!-- API Key -->
                            <TextBox x:Name="AiApiKeyBox" materialDesign:HintAssist.Hint="{DynamicResource Settings_AIApiKey}" 
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" Width="340" Margin="0,0,0,6"/>
                            <!-- API Endpoint -->
                            <TextBox x:Name="AiEndpointBox" materialDesign:HintAssist.Hint="{DynamicResource Settings_AIEndpoint}" 
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" Width="340" Margin="0,0,0,6"/>
                            <!-- 模型 -->
                            <TextBox x:Name="AiModelBox" materialDesign:HintAssist.Hint="{DynamicResource Settings_AIModel}" 
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" Width="340" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{DynamicResource Settings_Save}" Style="{StaticResource MaterialDesignFlatButton}" Click="SaveAI_Click" Margin="0,0,8,0"/>
                                <Button Content="{DynamicResource Settings_AITest}" Style="{StaticResource MaterialDesignFlatButton}" Click="TestAI_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 数据管理 -->
                <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{DynamicResource Settings_DataManagement}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

                        <!-- 导入文件夹 -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,6" Orientation="Horizontal">
                            <TextBox x:Name="FolderPathBox" Width="300" materialDesign:HintAssist.Hint="{DynamicResource Settings_FolderPath}"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,8,0" />
                            <Button Content="{DynamicResource Settings_ImportFolderBtn}" Style="{StaticResource MaterialDesignRaisedButton}" Click="ImportFolder_Click" Margin="0,0,8,0"/>
                            <CheckBox x:Name="RecursiveCheck" Content="{DynamicResource Settings_IncludeSubfolders}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 导出 -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,6" Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Settings_Export}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="CSV" Style="{StaticResource MaterialDesignRaisedButton}" Click="ExportCsv_Click" Margin="0,0,6,0"/>
                            <Button Content="JSON" Style="{StaticResource MaterialDesignRaisedButton}" Click="ExportJson_Click" Margin="0,0,6,0"/>
                            <Button Content="{DynamicResource Settings_FullBackup}" Style="{StaticResource MaterialDesignRaisedButton}" Click="ExportFullBackup_Click"/>
                        </StackPanel>

                        <!-- 导入 -->
                        <StackPanel Grid.Row="3" Margin="0,0,0,6" Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Settings_Import}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="CSV" Style="{StaticResource MaterialDesignRaisedButton}" Click="ImportCsv_Click" Margin="0,0,6,0"/>
                            <Button Content="JSON" Style="{StaticResource MaterialDesignRaisedButton}" Click="ImportJson_Click" Margin="0,0,6,0"/>
                            <Button Content="{DynamicResource Settings_RestoreData}" Style="{StaticResource MaterialDesignRaisedButton}" Click="RestoreBackup_Click"/>
                        </StackPanel>

                        <!-- 自动备份配置 -->
                        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="{DynamicResource Backup_Interval}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="BackupIntervalCombo" Style="{StaticResource MaterialDesignComboBox}" FontSize="13" Width="120" SelectionChanged="BackupInterval_Changed">
                                <ComboBoxItem Content="{DynamicResource Backup_Daily}" Tag="1" />
                                <ComboBoxItem Content="{DynamicResource Backup_Weekly}" Tag="7" />
                                <ComboBoxItem Content="{DynamicResource Backup_Monthly}" Tag="30" />
                                <ComboBoxItem Content="{DynamicResource Backup_Disabled}" Tag="0" />
                            </ComboBox>
                            <TextBlock Text="{DynamicResource Backup_MaxCount}" FontSize="13" VerticalAlignment="Center" Margin="24,0,8,0"/>
                            <ComboBox x:Name="MaxBackupCombo" Style="{StaticResource MaterialDesignComboBox}" FontSize="13" Width="80" SelectionChanged="MaxBackup_Changed">
                                <ComboBoxItem Content="5" Tag="5" />
                                <ComboBoxItem Content="10" Tag="10" />
                                <ComboBoxItem Content="20" Tag="20" />
                                <ComboBoxItem Content="50" Tag="50" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="{DynamicResource Backup_ManualBackup}" Style="{StaticResource MaterialDesignRaisedButton}" Click="ManualBackup_Click" Margin="0,0,8,0"/>
                            <Button Content="{DynamicResource Backup_OpenFolder}" Style="{StaticResource MaterialDesignFlatButton}" Click="OpenBackupFolder_Click"/>
                        </StackPanel>

                        <!-- 备份历史 -->
                        <TextBlock Grid.Row="7" Text="{DynamicResource Backup_History}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ListBox Grid.Row="8" x:Name="BackupHistoryList" MaxHeight="200"
                                 ScrollViewer.CanContentScroll="False"
                                 PreviewMouseWheel="BackupHistoryList_PreviewMouseWheel"
                                 materialDesign:ListBoxItemAssist.ShowSelection="False" Margin="0,0,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayText}" FontSize="12" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="{DynamicResource Backup_Restore}" Style="{StaticResource MaterialDesignFlatButton}" FontSize="11"
                                                Click="RestoreBackupItem_Click" Tag="{Binding FilePath}" Margin="4,0" />
                                        <Button Grid.Column="2" Content="{DynamicResource Backup_Delete}" Style="{StaticResource MaterialDesignFlatButton}" FontSize="11"
                                                Click="DeleteBackupItem_Click" Tag="{Binding FilePath}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- 分类与标签 -->
                <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{DynamicResource CatTag_Title}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="{DynamicResource Settings_CatTagHint}" FontSize="13"
                                       Foreground="{DynamicResource MaterialDesignHintForeground}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                            <Button x:Name="ManageCatTagBtn" Content="{DynamicResource Settings_ManageCatTag}"
                                    Style="{StaticResource MaterialDesignRaisedButton}" Click="ManageCatTag_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 文件夹监控 -->
                <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="文件夹监控" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <CheckBox x:Name="FolderMonitorToggle" Content="启用" VerticalAlignment="Center"
                                      Checked="FolderMonitorToggle_Changed" Unchecked="FolderMonitorToggle_Changed" />
                            <TextBlock x:Name="FolderMonitorStatus" Text="未启用" FontSize="12" VerticalAlignment="Center"
                                       Margin="12,0,0,0" Foreground="{DynamicResource MaterialDesignHintForeground}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="监控指定目录，检测新增视频文件（.mp4 .mkv .avi 等）" FontSize="13"
                                   Foreground="{DynamicResource MaterialDesignHintForeground}" Margin="0,0,0,6"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button x:Name="AddFolderBtn" Content="+ 添加目录" Style="{StaticResource MaterialDesignRaisedButton}"
                                    Click="AddMonitoredFolder_Click" Margin="0,0,8,0"/>
                            <Button x:Name="RemoveFolderBtn" Content="− 移除" Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Click="RemoveMonitoredFolder_Click" Margin="0,0,8,0"/>
                            <Button x:Name="AutoAddFoldersBtn" Content="从电影库提取" Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Click="AutoAddFolders_Click" ToolTip="扫描所有电影的文件路径，自动提取目录加入监控" Margin="0,0,8,0"/>
                            <Button x:Name="ScanNowBtn" Content="扫描现有文件" Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Click="ScanNow_Click" ToolTip="立即扫描监控目录中的现有视频文件"/>
                        </StackPanel>
                        <ListBox x:Name="MonitoredFolderList" Grid.Row="3" MaxHeight="120" Width="340"
                                 SelectionMode="Extended" Margin="0,0,0,0" HorizontalAlignment="Left" />
                    </Grid>
                </Border>

                <!-- 工具 -->
                <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{DynamicResource Settings_Tools}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                        <StackPanel Grid.Row="1">
                            <Button x:Name="DetectDuplicatesBtn" Content="{DynamicResource Settings_DetectDuplicates}"
                                    Style="{StaticResource MaterialDesignRaisedButton}" Click="DetectDuplicates_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 快捷键设置 -->
                <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{DynamicResource Settings_Shortcuts}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="{DynamicResource Shortcuts_SettingsHint}" FontSize="13" Foreground="{DynamicResource MaterialDesignHintForeground}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                            <Button x:Name="ConfigureShortcutsBtn"
                                    Content="{DynamicResource Settings_ConfigureShortcuts}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Click="ConfigureShortcuts_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="8" Padding="16">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{DynamicResource Settings_About}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="EasyMovie v1.03" FontSize="14" FontWeight="Bold"/>
                            <TextBlock Text="WPF + .NET 10 + SQLite" FontSize="13" Foreground="{DynamicResource MaterialDesignHintForeground}"/>
                            <TextBlock Text="{DynamicResource Settings_DataSources}" FontSize="13" Foreground="{DynamicResource MaterialDesignHintForeground}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
