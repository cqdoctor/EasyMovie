<Window x:Class="EasyMovie.Client.Views.VideoPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowStyle="None"
        WindowState="Maximized"
        Background="Black"
        SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="LowQuality"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Grid>
        <!-- 视频画面（WPF Image，由 VLC 帧回调渲染，无 HwndHost，控件可悬浮在其上） -->
        <Image x:Name="VideoImage" Stretch="Uniform" />

        <!-- 续播提示（悬浮居中） -->
        <Border x:Name="ResumePanel" Visibility="Collapsed"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="#CC1E1E2E" CornerRadius="12" Padding="24,16"
                Cursor="Hand" MouseLeftButtonUp="ResumePanel_MouseLeftButtonUp">
            <StackPanel>
                <TextBlock x:Name="ResumeText" Text="{DynamicResource Player_ResumePrompt}" FontSize="16"
                           Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock x:Name="ResumeTimeText" FontSize="13"
                           Foreground="#AAFFFFFF" HorizontalAlignment="Center" Margin="0,0,0,12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="ResumeYesBtn" Content="{DynamicResource Player_ResumeYes}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Foreground="White" Background="#7C4DFF" Margin="0,0,8,0"
                            Click="ResumeYes_Click" Cursor="Hand" />
                    <Button x:Name="ResumeNoBtn"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Click="ResumeNo_Click" Cursor="Hand">
                        <TextBlock Text="{DynamicResource Player_ResumeNo}" Foreground="White" FontSize="14" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 底部控制栏（悬浮在主窗口内） -->
        <Border x:Name="ControlBar" VerticalAlignment="Bottom"
                Background="#CC000000" Padding="16,8"
                Visibility="Collapsed" Cursor="Arrow">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 进度条 -->
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Slider x:Name="SeekBar" Minimum="0" Maximum="100" Value="0"
                            Style="{StaticResource MaterialDesignSlider}"
                            Thumb.DragStarted="SeekBar_DragStarted"
                            Thumb.DragCompleted="SeekBar_DragCompleted"
                            ValueChanged="SeekBar_ValueChanged" />
                    <TextBlock x:Name="SeekTooltip" Text="00:00"
                               Foreground="White" FontSize="11"
                               VerticalAlignment="Top" HorizontalAlignment="Left"
                               Margin="0,-16,0,0" Visibility="Collapsed" />
                </Grid>

                <!-- 控制按钮行 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 播放/暂停 -->
                    <Button Grid.Column="0" x:Name="PlayPauseBtn" Width="36" Height="36"
                            Style="{StaticResource MaterialDesignIconForegroundButton}"
                            Foreground="White" Click="PlayPause_Click" Cursor="Hand">
                        <materialDesign:PackIcon x:Name="PlayPauseIcon" Kind="Pause" Width="20" Height="20" />
                    </Button>

                    <!-- 停止 -->
                    <Button Grid.Column="1" Width="36" Height="36"
                            Style="{StaticResource MaterialDesignIconForegroundButton}"
                            Foreground="White" Click="Stop_Click" Cursor="Hand">
                        <materialDesign:PackIcon Kind="Stop" Width="18" Height="18" />
                    </Button>

                    <!-- 时间显示 -->
                    <TextBlock Grid.Column="2" x:Name="TimeLabel" Text="00:00 / 00:00"
                               Foreground="White" FontSize="12" VerticalAlignment="Center"
                               Margin="8,0,0,0" />

                    <!-- 片名 -->
                    <TextBlock Grid.Column="3" x:Name="TitleLabel" Text=""
                               Foreground="#AAFFFFFF" FontSize="12" VerticalAlignment="Center"
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Margin="16,0" />

                    <!-- 音量 -->
                    <materialDesign:PackIcon Grid.Column="4" x:Name="VolumeIcon" Kind="VolumeHigh"
                                              Width="16" Height="16" Foreground="White"
                                              VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Slider Grid.Column="5" x:Name="VolumeSlider" Width="80" Minimum="0" Maximum="100" Value="80"
                            Style="{StaticResource MaterialDesignSlider}"
                            ValueChanged="VolumeSlider_ValueChanged" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
