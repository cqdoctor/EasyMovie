<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================ -->
    <!-- 公共样式模板（颜色通过 DynamicResource 引用 Skin 刷子） -->
    <!-- ============================================ -->

    <!-- 滚动条皮肤颜色刷子（LoadSkin 会覆盖） -->
    <SolidColorBrush x:Key="Skin.ScrollBarThumbBrush" Color="#55FFFFFF" />
    <SolidColorBrush x:Key="Skin.ScrollBarThumbHoverBrush" Color="#AAFFFFFF" />

    <!-- 滚动条：继承 MaterialDesign 原生模板，仅调窄宽度 -->
    <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 统计卡片样式 -->
    <Style x:Key="StatCardStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

</ResourceDictionary>