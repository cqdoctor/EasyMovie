<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- M1（2026-09-20）：已从 NoWarn 中移除 CS4014 与全部 CS86xx，恢复可空/异步静态保护。
         原先抑制的 CS4014 实为 4 处 Dispatcher.BeginInvoke（有意 fire-and-forget），已改为显式 `_ =` 丢弃表达意图；
         CS8602/CS8604/CS8625 共 4 处已按真实根因修复（字段窄化、索引器再求值、给事件形参塞 null）。
         仍保留的两项为确实无法修复的误报：
         NU1701 = 传递依赖包的目标框架元数据不完整（仅提示级，不影响 net10.0-windows 运行）；
         CA1416 = MDIX 的 PackIcon/Card 被平台兼容性分析器误判为"仅 Windows 支持"（本项目即 net10.0-windows）。 -->
    <NoWarn>NU1701;CA1416</NoWarn>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.03</Version>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    <!-- 启动提速：发布预编译本机镜像 + 分层 PGO，避免每次启动 JIT 编译大依赖库 -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- 启动闪屏改为手动控制（见 App.xaml.cs）：先 Show(false)，等主窗口+所有导航页构造完成后再平滑 Close，
         避免“闪屏未隐藏、主窗口已显示”的重叠衔接问题。这里以普通 Resource 嵌入，供 SplashScreen 构造函数按资源名加载。 -->
    <Resource Include="app.png" />
    <Resource Include="app.ico" />
    <Resource Include="app_multisize.ico" />
    <Resource Include="app_white.ico" />
    <Resource Include="transparent.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EasyMovie.Core\EasyMovie.Core.csproj" />
    <ProjectReference Include="..\EasyMovie.Data\EasyMovie.Data.csproj" />
    <ProjectReference Include="..\EasyMovie.Tools\EasyMovie.Tools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.9.3" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="MaterialDesignThemes" Version="5.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="EasyMovie.Core" />
  </ItemGroup>

</Project>
